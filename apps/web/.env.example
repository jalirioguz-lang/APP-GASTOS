# Valores públicos de Supabase local o del entorno de prueba. Nunca incluya service_role,
# contraseñas de base de datos, JWT privados ni secretos en este archivo.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Origen canónico usado por el enlace de verificación (ejemplo: http://127.0.0.1:3000).
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
